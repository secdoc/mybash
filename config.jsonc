{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "popos",
    "padding": { "top": 0, "right": 2 },
    "color": { "1": "yellow", "2": "red" }
  },
  "display": {
    "separator": ": ",
    "key": { "width": 10 },
    "size": { "binaryPrefix": "iec" },
    "percent": { "type": 3, "green": 50, "yellow": 80 }
  },
  "modules": [
    { "type": "title", "fqdn": true, "keyColor": "yellow" },
    { "type": "host", "key": "HOST", "keyColor": "yellow" },
    { "type": "cpu", "key": "CPU", "keyColor": "yellow" },
    { "type": "gpu", "key": "GPU", "keyColor": "yellow" },
    { "type": "disk", "key": "Disk ({mountpoint})", "folders": "/:/mnt/data:/mnt/storage:/recovery", "keyColor": "yellow" },
    { "type": "memory", "key": "MEMORY", "keyColor": "yellow" },
    { "type": "swap", "key": "SWAP", "keyColor": "yellow" },
    { "type": "sound", "key": "AUDIO", "format": "\u001b[38;2;239;128;47m{name} ({volume-percentage})\u001b[0m", "keyColor": "38;2;239;128;47" },
    { "type": "display", "key": "Monitor", "compactType": "original-with-refresh-rate", "keyColor": "yellow" },
    { "type": "localip", "key": "LOCAL IP", "compact": false, "showMac": true, "keyColor": "yellow" },
    { "type": "netio", "key": "IFNAME", "format": "{ifname}", "keyColor": "yellow" },
    { "type": "wifi", "key": "WIFI", "format": "{ssid}", "keyColor": "yellow" },
    "break",
    { "type": "de", "key": "DE", "keyColor": "red" },
    { "type": "wm", "key": "WM", "keyColor": "red" },
    { "type": "shell", "key": "SHELL", "keyColor": "red" },
    { "type": "terminal", "key": "TERMINAL", "keyColor": "red" },
    "break",
    { "type": "os", "key": "OS", "keyColor": "white" },
    { "type": "kernel", "key": "KERNEL", "format": "{release}", "keyColor": "white" },
    { "type": "packages", "key": "PACKAGES", "keyColor": "white" },
    { "type": "uptime", "key": "UPTIME", "keyColor": "white" }
  ]
}
